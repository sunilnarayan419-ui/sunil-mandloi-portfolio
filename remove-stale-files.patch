-/* ============================================================
-   SCIENTIFIC / DIAGRAM ELEMENTS (expertise visualization, bg motifs)
-   ============================================================ */
-
-.diagram-line {
-  stroke: var(--pink-super);
-  stroke-width: 1;
-  opacity: 0.6;
-}
-
-.diagram-node {
-  fill: var(--pink-thulian);
-}
-
-.diagram-node--core {
-  fill: var(--pink-light-deep);
-  filter: drop-shadow(0 0 6px rgba(255, 92, 205, 0.5));
-}
-
-.bg-motif {
-  color: var(--pink-super);
-  opacity: 0.08; /* keep decorative geometry subtle, never competing with text */
-}
-
-/* ============================================================
-   UTILITY — never let contrast fall below this pairing
-   ============================================================ */
-
-.on-light { color: var(--text); background: var(--bg); }
-.on-dark  { color: var(--text-on-dark); background: var(--surface-dark); }
